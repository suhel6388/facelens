# PostgreSQL
POSTGRES_USER=facelens
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=facelens
DATABASE_URL=postgresql://facelens:replace-with-strong-postgres-password@postgres:5432/facelens

# Redis
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379

# API & Auth Secrets (minimum 32 random bytes each)
NODE_ENV=production
API_PORT=4000
WEB_ORIGIN=https://facelens.example.com
NEXT_PUBLIC_API_URL=https://facelens.example.com/api/v1
ACCESS_TOKEN_SECRET=replace-with-64-char-random-hex
REFRESH_TOKEN_SECRET=replace-with-64-char-random-hex
PRIVATE_STORAGE_DIR=/var/lib/facelens/storage
AI_SERVICE_URL=http://ai-service:8000
LOG_LEVEL=info

# Razorpay Billing
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

